{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/*.mjs": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/**"
    }
  },
  "git": { "deploymentEnabled": false }
}
